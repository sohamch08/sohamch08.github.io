<feed xmlns="http://www.w3.org/2005/Atom">
  <id>{{ site.Home.Permalink }}</id>
  <title>{{ site.Title }}</title>
  <subtitle>{{ site.Params.description }}</subtitle>
  <updated>{{ now.Format "2006-01-02T15:04:05Z07:00" }}</updated>
  <author><name>{{ site.Title }}</name><uri>{{ site.Home.Permalink }}</uri></author>
  <link rel="self" type="application/atom+xml" href="{{ "feed.xml" | absURL }}"/>
  <link rel="alternate" type="text/html" hreflang="en" href="{{ site.Home.Permalink }}"/>
  <generator uri="https://gohugo.io/" version="{{ hugo.Version }}">Hugo</generator>
  <rights>© {{ now.Year }} {{ site.Title }}</rights>
  <icon>{{ "assets/img/favicons/favicon.ico" | relURL }}</icon>
  <logo>{{ "assets/img/favicons/favicon-96x96.png" | relURL }}</logo>
</feed>
