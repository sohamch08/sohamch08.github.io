{
  "name": "soham-hugo-site",
  "version": "1.0.0",
  "private": true,
  "description": "Soham Chatterjee's website, built with Hugo and the original Chirpy design.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "hugo --minify",
    "dev": "hugo server --disableFastRender",
    "build:js": "rollup -c --environment BUILD:production",
    "watch:js": "rollup -c -w",
    "test": "bash tools/test.sh"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "5.3.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-private-methods": "^7.27.1",
    "@babel/preset-env": "^7.28.3",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "rollup": "^4.52.5"
  }
}
